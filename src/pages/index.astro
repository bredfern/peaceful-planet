---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍Hello</h1>
			<p>
      This is the website and blog for me, the writer musician and technologist Brian Redfern.
			</p>
      <p>
      Some of my claims to fame are creating the sound track and sound effects for the Linux video game Chromium BSU. I was part of the pre ipo team at Geocities and have been developing for the web since 1995.
      </p>
		</main>
		<Footer />
	</body>
</html>
